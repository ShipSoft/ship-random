@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/SHiPRandomTargets.cmake")

# Random123 is header-only and ships no CMake config; find it here so the
# exported target does not carry the build machine's include path.
find_path(Random123_INCLUDE_DIR Random123/philox.h)
if(NOT Random123_INCLUDE_DIR)
    set(SHiPRandom_FOUND FALSE)
    set(SHiPRandom_NOT_FOUND_MESSAGE
        "SHiPRandom needs Random123 (Random123/philox.h not found)"
    )
    return()
endif()
set_property(
    TARGET SHiP::Random
    APPEND
    PROPERTY INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${Random123_INCLUDE_DIR}"
)
set_property(
    TARGET SHiP::Random
    APPEND
    PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${Random123_INCLUDE_DIR}"
)

check_required_components(SHiPRandom)
